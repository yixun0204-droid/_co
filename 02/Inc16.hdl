// File name: projects/02/Inc16.hdl

/**
 * 16-bit incrementer:
 * out = in + 1 (arithmetic addition)
 */

CHIP Inc16 {
    IN in[16];
    OUT out[16];

    PARTS:

    // 將輸入 in 與數字 1 相加
    Add16(
        a=in,
        b[0]=true,
        b[1..15]=false,
        out=out
    );
}
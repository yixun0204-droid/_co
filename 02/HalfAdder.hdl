// File name: projects/02/HalfAdder.hdl

/**
 * Computes the sum of two bits.
 */

CHIP HalfAdder {
    IN a, b;
    OUT sum, carry;

    PARTS:

    // 計算兩個位元的 XOR，得到 sum
    Xor(a=a, b=b, out=sum);

    // 計算兩個位元的 AND，得到 carry
    And(a=a, b=b, out=carry);
}